# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in your own values.
#   cp .env.example .env.local
#
# Three things are required, for every provider:
#   1. where to call   → LLM_BASE_URL   (or LLM_PROVIDER, which fills it in)
#   2. which model     → LLM_MODEL
#   3. how to auth     → LLM_API_KEY
#
# .env.local is gitignored and is NEVER exposed to the browser: the key is read
# on the server only, inside /api/generate.
# ---------------------------------------------------------------------------

# 1. WHERE. The OpenAI-compatible base URL of the endpoint you want to call.
#    Examples:
#      https://openrouter.ai/api/v1
#      https://api.groq.com/openai/v1
#      https://api.openai.com/v1
#      https://api.anthropic.com/v1
#      https://generativelanguage.googleapis.com/v1beta/openai
#      https://api.mistral.ai/v1
#      https://api.deepseek.com/v1
#      https://api.x.ai/v1
#      http://localhost:11434/v1                  (Ollama, local)
LLM_BASE_URL=

# Optional shorthand for the URL above. Setting this fills LLM_BASE_URL in for
# you and tells the app which key variable to look for. Any other name works
# too, as long as LLM_BASE_URL is set.
#   openrouter | groq | openai | anthropic | google | mistral | deepseek |
#   xai | ollama | custom
LLM_PROVIDER=

# 2. WHICH MODEL. Required. The app never assumes a model for any provider —
#    model names change too often for a built-in default to stay correct.
#    Copy the exact id from your provider's model list, for example:
#      openrouter  openai/gpt-4o-mini, anthropic/claude-sonnet-4.5, meta-llama/llama-3.3-70b-instruct
#      groq        openai/gpt-oss-120b, llama-3.1-8b-instant
#      openai      gpt-4o-mini
#      google      gemini-2.5-flash
#      mistral     mistral-small-latest
LLM_MODEL=

# 3. HOW TO AUTH. The key for whichever endpoint LLM_BASE_URL points at.
#    Optional only for keyless local servers such as Ollama.
#    Provider-specific names also work, so you can reuse what you already
#    export: GROQ_API_KEY, OPENAI_API_KEY, ANTHROPIC_API_KEY, GEMINI_API_KEY,
#    GOOGLE_API_KEY, MISTRAL_API_KEY, DEEPSEEK_API_KEY, XAI_API_KEY.
LLM_API_KEY=

# --- Optional --------------------------------------------------------------
# Attribution headers, sent only to providers that use them (OpenRouter).
LLM_SITE_URL=
LLM_SITE_NAME=

# Name of the token-limit field. Defaults to max_completion_tokens, which is what
# OpenRouter and Groq document today. Uncomment to use max_tokens instead, for
# older self-hosted servers (vLLM, older Ollama builds).
# LLM_MAX_TOKENS_FIELD=max_tokens

# Sampling temperature, 0-2. Unset means 0.7. Uncomment and leave empty to omit
# the field entirely, which some reasoning models require.
# LLM_TEMPERATURE=

# --- Backwards compatibility ------------------------------------------------
# These keep working, but only while the provider is openrouter (or unset), so a
# key meant for one provider can never be sent to another.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=
