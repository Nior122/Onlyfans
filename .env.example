# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in your own values.
#   cp .env.example .env.local
# .env.local is gitignored and is NEVER exposed to the browser.
# ---------------------------------------------------------------------------

# Required. Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model used for every generation. Any OpenRouter chat model works.
# Default is a low-cost, high-throughput model — swap it freely.
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional. Sent to OpenRouter as HTTP-Referer (attribution / leaderboards).
OPENROUTER_SITE_URL=http://localhost:3000

# Optional. Sent to OpenRouter as X-Title.
OPENROUTER_SITE_NAME=Master Prompt Builder

# Optional. Overrides the OpenRouter API base URL — useful for a proxy/gateway
# or for pointing tests at a mock server. Defaults to https://openrouter.ai/api/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
