# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in your own values.
#   cp .env.example .env.local
# .env.local is gitignored and is NEVER exposed to the browser: the key is read
# on the server only, inside /api/generate.
# ---------------------------------------------------------------------------

# Which provider to call. Any OpenAI-compatible endpoint works.
#   openrouter | groq | openai | anthropic | google | mistral | deepseek |
#   xai | ollama | custom
# Defaults to openrouter. See the README for base URLs and default models.
LLM_PROVIDER=openrouter

# The key for the selected provider. Required, except for ollama/custom, which
# may run without credentials. Provider-specific names also work, so you can
# reuse the ones you already export: GROQ_API_KEY, OPENAI_API_KEY,
# ANTHROPIC_API_KEY, GEMINI_API_KEY, MISTRAL_API_KEY, DEEPSEEK_API_KEY, XAI_API_KEY.
LLM_API_KEY=

# Optional. Overrides the model. OpenRouter and Groq have built-in defaults
# (openai/gpt-4o-mini and openai/gpt-oss-120b); every other provider needs this.
LLM_MODEL=

# Optional. Point at a gateway, a proxy, or any OpenAI-compatible server.
LLM_BASE_URL=

# Optional. Attribution headers, sent only to providers that use them (OpenRouter).
LLM_SITE_URL=
LLM_SITE_NAME=

# --- Advanced --------------------------------------------------------------
# Name of the token-limit field. Defaults to max_completion_tokens, which is what
# OpenRouter and Groq document today. Set it to max_tokens for older self-hosted
# servers (vLLM, older Ollama builds). Uncomment to use it.
# LLM_MAX_TOKENS_FIELD=max_tokens

# Sampling temperature, 0-2. Unset means 0.7. Uncomment and leave empty to omit
# the field entirely, which some reasoning models require.
# LLM_TEMPERATURE=

# --- Backwards compatibility ------------------------------------------------
# These keep working, but only while LLM_PROVIDER is openrouter (or unset), so a
# key meant for one provider can never be sent to another.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=
